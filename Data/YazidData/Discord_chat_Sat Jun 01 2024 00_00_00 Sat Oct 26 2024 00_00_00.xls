<Data ss:Type="String">.mar1one</Data></Cell><Cell><Data ss:Type="String">#0</Data></Cell><Cell><Data ss:Type="String">This from an official document that was sent to us in December 2022 from Pr Guessoum</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">2024-10-24,21:08:47</Data></Cell><Cell><Data ss:Type="String">.mar1one</Data></Cell><Cell><Data ss:Type="String">#0</Data></Cell><Cell><Data ss:Type="String">The full document:</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">https://cdn.discordapp.com/attachments/884245176854380544/1299102313507586158/formation_ENSIA_pour_des_ingenieurs_delite_7Dec_1.pdf?ex=671e9dcf&amp;is=671d4c4f&amp;hm=3aadd28f44f92569b683e14b9a4cf5fffd8d934da4e7a71f819ba1137783e638&amp;</Data></Cell></Row><Row><Cell><Data ss:Type="String">2024-10-24,21:08:58</Data></Cell><Cell><Data ss:Type="String">_larbi</Data></Cell><Cell><Data ss:Type="String">#0</Data></Cell><Cell><Data ss:Type="String">Slay</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">2024-10-24,23:31:35</Data></Cell><Cell><Data ss:Type="String">.sanssoucis</Data></Cell><Cell><Data ss:Type="String">#0</Data></Cell><Cell><Data ss:Type="String">Thanks this will help us !!</Data></Cell><Cell><Data ss:Type="String">.mar1one#0</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">2024-10-25,14:30:05</Data></Cell><Cell><Data ss:Type="String">besmalabendif._37737</Data></Cell><Cell><Data ss:Type="String">#0</Data></Cell><Cell><Data ss:Type="String">guys we have hedok 5 dayd te3 novembre wla nn?</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">2024-10-25,14:55:07</Data></Cell><Cell><Data ss:Type="String">.mar1one</Data></Cell><Cell><Data ss:Type="String